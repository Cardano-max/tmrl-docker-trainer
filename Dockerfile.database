FROM python:3.10-alpine

WORKDIR /app

# Install Python packages needed for analysis
RUN pip install --no-cache-dir numpy

# Create data directory structure
RUN mkdir -p /shared-data/episodes \
             /shared-data/states \
             /shared-data/actions \
             /shared-data/metrics \
             /shared-data/transitions \
             /shared-data/db_store \
             /shared-data/db_to_trainer

# Copy database analyzer script
COPY db_main.py /app/

# Volume mount point
VOLUME ["/shared-data"]

# Run database analyzer
CMD ["python", "-u", "/app/db_main.py"]