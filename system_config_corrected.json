{
  "system_name": "TMRL_Knowledge_System_Corrected",
  "version": "3.1.0",
  "description": "Corrected system following supervisor's architecture",
  
  "actions": {
    "gas": {
      "type": "continuous",
      "description": "Acceleration pedal",
      "range": [0.0, 1.0],
      "unit": "normalized",
      "bins": [
        {"min": 0.0, "max": 0.1, "label": "NONE"},
        {"min": 0.1, "max": 0.4, "label": "LOW"},
        {"min": 0.4, "max": 0.7, "label": "MED"},
        {"min": 0.7, "max": 1.1, "label": "HIGH"}
      ]
    },
    "brake": {
      "type": "continuous",
      "description": "Brake pedal",
      "range": [0.0, 1.0],
      "unit": "normalized",
      "bins": [
        {"min": 0.0, "max": 0.1, "label": "NONE"},
        {"min": 0.1, "max": 0.4, "label": "LOW"},
        {"min": 0.4, "max": 0.7, "label": "MED"},
        {"min": 0.7, "max": 1.1, "label": "HIGH"}
      ]
    },
    "steering": {
      "type": "continuous",
      "description": "Steering wheel",
      "range": [-1.0, 1.0],
      "unit": "normalized",
      "bins": [
        {"min": -1.1, "max": -0.66, "label": "LEFT_FULL"},
        {"min": -0.66, "max": -0.33, "label": "LEFT_MED"},
        {"min": -0.33, "max": -0.1, "label": "LEFT_SMALL"},
        {"min": -0.1, "max": 0.1, "label": "STRAIGHT"},
        {"min": 0.1, "max": 0.33, "label": "RIGHT_SMALL"},
        {"min": 0.33, "max": 0.66, "label": "RIGHT_MED"},
        {"min": 0.66, "max": 1.1, "label": "RIGHT_FULL"}
      ]
    }
  },
  
  "feedbacks": {
    "speed": {
      "description": "Vehicle velocity",
      "unit": "km/h",
      "interval_size": 0.5,
      "expected_range": [0.0, 50.0],
      "constraint_type": "soft",
      "critical": true
    },
    "lidar_0": {
      "description": "Forward center distance",
      "unit": "arbitrary_units",
      "interval_size": 5.0,
      "expected_range": [0.0, 500.0],
      "constraint_type": "hard",
      "critical": false
    },
    "lidar_1": {
      "description": "Forward left distance",
      "unit": "arbitrary_units",
      "interval_size": 5.0,
      "expected_range": [0.0, 500.0],
      "constraint_type": "hard",
      "critical": false
    },
    "lidar_2": {
      "description": "Forward right distance",
      "unit": "arbitrary_units",
      "interval_size": 5.0,
      "expected_range": [0.0, 500.0],
      "constraint_type": "hard",
      "critical": false
    }
  },
  
  "system_config": {
    "database_host": "falkordb",
    "database_port": 6379,
    "checkpoint_path": "/root/TmrlData/checkpoints",
    "processing_batch_size": 100,
    "max_episode_length": 10000,
    "enable_caching": true,
    "cache_size": 10000,
    "log_level": "INFO",
    "retry_attempts": 3,
    "retry_delay": 1.0
  },
  
  "intelligence_config": {
    "awareness": {
      "enabled": true,
      "tolerance": 0.01,
      "description": "Comparing knowledge vs reality"
    },
    "repeat_episode": {
      "enabled": true,
      "frame_tolerance": 100
    },
    "exploration": {
      "enabled": true,
      "prioritize_untried": true
    },
    "future_constraints": {
      "enabled": true,
      "simulation_mode": true
    },
    "range_monitor": {
      "enabled": true,
      "alert_threshold": 10
    }
  },
  
  "memory_config": {
    "short_term_capacity": 10,
    "action_memory_size": 1000,
    "state_history_size": 1000
  }
}