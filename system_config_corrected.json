{
  "system_name": "Real_Intelligence_System",
  "version": "4.0.0",
  "description": "Production-grade Real Intelligence System - Environment Agnostic",
  
  "actions": {
    "gas": {
      "type": "continuous",
      "description": "Acceleration control",
      "range": [0.0, 1.0],
      "unit": "normalized",
      "disjoint": ["brake"],
      "bins": [
        {"min": 0.0, "max": 0.1, "label": "NONE"},
        {"min": 0.1, "max": 0.4, "label": "LOW"},
        {"min": 0.4, "max": 0.7, "label": "MED"},
        {"min": 0.7, "max": 1.1, "label": "HIGH"}
      ]
    },
    "brake": {
      "type": "continuous",
      "description": "Braking control",
      "range": [0.0, 1.0],
      "unit": "normalized",
      "disjoint": ["gas"],
      "bins": [
        {"min": 0.0, "max": 0.1, "label": "NONE"},
        {"min": 0.1, "max": 0.4, "label": "LOW"},
        {"min": 0.4, "max": 0.7, "label": "MED"},
        {"min": 0.7, "max": 1.1, "label": "HIGH"}
      ]
    },
    "steering": {
      "type": "continuous",
      "description": "Directional control",
      "range": [-1.0, 1.0],
      "unit": "normalized",
      "disjoint": [],
      "bins": [
        {"min": -1.1, "max": -0.66, "label": "LEFT_FULL"},
        {"min": -0.66, "max": -0.33, "label": "LEFT_MED"},
        {"min": -0.33, "max": -0.1, "label": "LEFT_SMALL"},
        {"min": -0.1, "max": 0.1, "label": "STRAIGHT"},
        {"min": 0.1, "max": 0.33, "label": "RIGHT_SMALL"},
        {"min": 0.33, "max": 0.66, "label": "RIGHT_MED"},
        {"min": 0.66, "max": 1.1, "label": "RIGHT_FULL"}
      ]
    }
  },
  
  "disjoint_rules": {
    "description": "Actions that cannot occur simultaneously (from ontology)",
    "pairs": [
      ["gas", "brake"]
    ],
    "validation_mode": "strict"
  },
  
  "feedbacks": {
    "speed": {
      "description": "Velocity feedback",
      "unit": "abstract_units",
      "interval_size": 0.5,
      "expected_range": [0.0, 50.0],
      "constraint_type": "soft",
      "critical": true
    },
    "lidar_0": {
      "description": "Forward center distance sensor",
      "unit": "abstract_units",
      "interval_size": 5.0,
      "expected_range": [0.0, 500.0],
      "constraint_type": "hard",
      "critical": false
    },
    "lidar_1": {
      "description": "Forward left distance sensor",
      "unit": "abstract_units",
      "interval_size": 5.0,
      "expected_range": [0.0, 500.0],
      "constraint_type": "hard",
      "critical": false
    },
    "lidar_2": {
      "description": "Forward right distance sensor",
      "unit": "abstract_units",
      "interval_size": 5.0,
      "expected_range": [0.0, 500.0],
      "constraint_type": "hard",
      "critical": false
    }
  },
  
  "system_config": {
    "database_host": "falkordb",
    "database_port": 6379,
    "checkpoint_path": "/root/TmrlData/checkpoints",
    "processing_batch_size": 100,
    "max_episode_length": 10000,
    "enable_caching": true,
    "cache_size": 10000,
    "log_level": "INFO",
    "retry_attempts": 3,
    "retry_delay": 1.0
  },
  
  "intelligence_config": {
    "awareness": {
      "enabled": true,
      "tolerance": 0.01,
      "description": "Comparing knowledge vs reality (supervisor's awareness intelligence)"
    },
    "repeat_episode": {
      "enabled": true,
      "frame_tolerance": 100
    },
    "exploration": {
      "enabled": true,
      "prioritize_untried": true
    },
    "future_constraints": {
      "enabled": true,
      "simulation_mode": true,
      "description": "Hard constraints = MUST obey, Soft constraints = SHOULD follow"
    },
    "range_monitor": {
      "enabled": true,
      "alert_threshold": 10
    }
  },
  
  "memory_config": {
    "short_term_capacity": 10,
    "action_memory_size": 1000,
    "state_history_size": 1000
  },
  
  "knowledge_config": {
    "prior_knowledge": {
      "description": "Knowledge from config (supervisor: prior knowledge)",
      "sources": ["actions", "feedbacks", "constraints"]
    },
    "acquired_knowledge": {
      "description": "Knowledge from experience (supervisor: acquired knowledge)",
      "storage": "knowledge_graphs"
    }
  }
}