{
  "system_name": "Sutton_Intelligence_System",
  "version": "1.0.0",
  "description": "TMNF + TMInterface 2.x -- Pure Sutton compliance",

  "actions": {
    "gas": {
      "description": "Throttle (TMNF: binary >0.001 = full gas ON)",
      "range": [0.0, 1.0],
      "input_type": "binary"
    },
    "brake": {
      "description": "Brake (TMNF: binary >0.001 = full brake ON)",
      "range": [0.0, 1.0],
      "input_type": "binary"
    },
    "left": {
      "description": "Steer left (TMNF: binary digital key)",
      "range": [0.0, 1.0],
      "input_type": "binary"
    },
    "right": {
      "description": "Steer right (TMNF: binary digital key)",
      "range": [0.0, 1.0],
      "input_type": "binary"
    }
  },

  "feedbacks": {
    "speed": {
      "description": "Vehicle speed from velocity vector",
      "unit": "km/h",
      "precision": 0.6,
      "track_graph": true
    },
    "pos_x": {
      "description": "World X position",
      "unit": "meters",
      "precision": 0.01,
      "track_graph": true
    },
    "pos_y": {
      "description": "World Y position (vertical)",
      "unit": "meters",
      "precision": 0.01,
      "track_graph": true
    },
    "pos_z": {
      "description": "World Z position",
      "unit": "meters",
      "precision": 0.01,
      "track_graph": true
    },
    "yaw": {
      "description": "Vehicle yaw orientation",
      "unit": "radians",
      "precision": 0.001,
      "track_graph": true
    },
    "velocity_x": {
      "description": "X velocity component",
      "unit": "m/s",
      "precision": 0.1,
      "track_graph": false
    },
    "velocity_y": {
      "description": "Y velocity component",
      "unit": "m/s",
      "precision": 0.1,
      "track_graph": false
    },
    "velocity_z": {
      "description": "Z velocity component",
      "unit": "m/s",
      "precision": 0.1,
      "track_graph": false
    },
    "rpm": {
      "description": "Engine RPM",
      "unit": "rpm",
      "precision": 100.0,
      "track_graph": false
    },
    "gear": {
      "description": "Current gear",
      "unit": "integer",
      "precision": 1.0,
      "track_graph": false
    }
  },

  "environment": {
    "type": "tmnf",
    "adapter": "adapters.tmnf_adapter.TMNFAdapter",
    "protocol": "tcp",
    "host": "127.0.0.1",
    "port": 8476
  },

  "experimentation": {
    "enabled": true,
    "min_probe_speed_kmh": 10.0,
    "use_rewind": true,
    "description": "Bin discovery via Sutton downward sweep algorithm. Precision is discovered by the system, not configured."
  },

  "prior_knowledge": {
    "check_on_startup": true,
    "results_dir": ".",
    "results_pattern": "tmnf_phase_a_results_*.json",
    "description": "Sutton Jan 24: if prior knowledge exists, skip experimentation"
  }
}
