FROM python:3.10-slim

WORKDIR /app

# Install system dependencies INCLUDING OpenGL libraries for OpenCV
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip install --no-cache-dir \
    tmrl \
    falkordb \
    numpy \
    scipy \
    torch \
    pandas

# Copy all training files
COPY train_with_mpc_direct.py /app/
COPY train_with_falkordb.py /app/
COPY falkordb_manager.py /app/
COPY exploration_system.py /app/
COPY path_tracker.py /app/
COPY interval_goals.py /app/
COPY knowledge_graph_planner.py /app/
COPY mpc_optimizer.py /app/
COPY safety_supervisor.py /app/
COPY test_mpc_system.py /app/
COPY mpc_memory_processor.py /app/

# 🔥 ADD THE NEW FILES HERE (THIS IS WHAT YOU WERE MISSING)
COPY exploration_module.py /app/
COPY mpc_memory_processor_v2.py /app/
COPY test_exploration_live.py /app/
# 🔥 END OF NEW FILES

# Create config directory and copy config
RUN mkdir -p /root/TmrlData/config
COPY trainer_config.json /root/TmrlData/config/config.json

# Set Python path
ENV PYTHONPATH=/app:$PYTHONPATH

# Default: run MPC direct trainer
CMD ["python3", "train_with_mpc_direct.py"]
